      "isDeleted": false,
      "boundElements": [],
      "updated": 1774632708959,
      "link": null,
      "locked": false,
      "text": "1. only Backup and Archive\n\n2. Need transactional record level access\n\n3. Need server images or video to end users  - use Azure CDN (Content delivery network)\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. only Backup and Archive\n\n2. Need transactional record level access\n\n3. Need server images or video to end users  - use Azure CDN (Content delivery network)\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
