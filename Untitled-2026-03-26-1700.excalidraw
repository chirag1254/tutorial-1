      "text": "WHEN ADLS - GEN2",
      "fontSize": 23.63576092408778,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHEN ADLS - GEN2",
