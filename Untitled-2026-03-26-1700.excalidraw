    {
      "id": "aFQPdDBB1oNxHquNRCuzH",
      "type": "text",
      "x": 436.8327228173822,
      "y": 7205.439116859072,
      "width": 871.6994018554688,
      "height": 175,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
