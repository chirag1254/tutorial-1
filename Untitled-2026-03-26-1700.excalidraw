    },
    {
      "id": "XtebEPNWdTEuC1du25Wdt",
      "type": "text",
      "x": 1014.72049382198,
      "y": 7509.492619905188,
      "width": 582.7996826171875,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1J",
      "roundness": null,
      "seed": 928161763,
      "version": 580,
      "versionNonce": 1130283203,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774632734073,
      "link": null,
      "locked": false,
      "text": "ADLS Gen2 with a four-container design — \nraw, bronze, silver, gold. \n\nRBAC security groups per team. \n- The Risk service principal has Contributor access \n on the raw container only. \n- The Compliance group has Reader on silver. \n- Reporting has Reader on gold. \n\n- Scale: approximately 150 gigabytes of raw data per day, \n    50 million files per year of retention, 4 terabytes total. \n \n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ADLS Gen2 with a four-container design — \nraw, bronze, silver, gold. \n\nRBAC security groups per team. \n- The Risk service principal has Contributor access \n on the raw container only. \n- The Compliance group has Reader on silver. \n- Reporting has Reader on gold. \n\n- Scale: approximately 150 gigabytes of raw data per day, \n    50 million files per year of retention, 4 terabytes total. \n \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lkOsT6v8rrbpFssBki92c",
      "type": "text",
