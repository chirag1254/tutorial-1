    {
      "id": "JTn35tGkk9LZb5axj5c2d",
      "type": "text",
      "x": 992.1743851017409,
      "y": 8462.404830368003,
      "width": 679.759860570769,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
