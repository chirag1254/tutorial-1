    {
      "id": "1rVaZ82xFg9vEP5sdd9ws",
      "type": "text",
      "x": 296.7018317761109,
      "y": 8480.881454807124,
      "width": 511.03341061547025,
      "height": 175,
      "angle": 0,
      "strokeColor": "#3d3d3d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
