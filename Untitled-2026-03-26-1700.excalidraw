      "seed": 526689165,
      "version": 1689,
      "versionNonce": 1371463011,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774632734073,
      "link": null,
      "locked": false,
      "text": "ADLS Gen2 with a time-partitioned hierarchy: \n/raw/sensors/plant ID/year/month/day/hour. \n\nThis partition layout is designed specifically for Spark partition\npruning. A query for last week, plant A scans only 7 directories\ninstead of the full dataset. \n\nScale: 2 terabytes per day, 730 terabytes annual. \n        Hot tier for the last 90 days, \n        Cool tier for archive.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ADLS Gen2 with a time-partitioned hierarchy: \n/raw/sensors/plant ID/year/month/day/hour. \n\nThis partition layout is designed specifically for Spark partition pruning. A query for last week, plant A scans only 7 directories instead of the full dataset. \n\nScale: 2 terabytes per day, 730 terabytes annual. \n        Hot tier for the last 90 days, \n        Cool tier for archive.",
      "autoResize": false,
      "lineHeight": 1.25
    },
