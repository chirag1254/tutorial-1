    },
    {
      "id": "ULOTBwAL3WqEw85P7zhrs",
      "type": "text",
      "x": 406.22346751946657,
      "y": 6782.1862552628345,
      "width": 662.0994873046875,
      "height": 300,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1X",
      "roundness": null,
      "seed": 1939200675,
      "version": 425,
      "versionNonce": 1114084909,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774632097080,
      "link": null,
      "locked": false,
      "text": "1. Building any analytical workload - ADF , DBX or Synapse\n\n2. Need to store - structured , semi or unstructured files\n\n3. Multiple Compute engines - ADF ,  DBX etc. - simultanious access\n\n4. Folder level security access\n\n5. Atomic Writes \n\n6 Data Volume > 1gb per day for analytics \n                      Don't use - SQL DB, Blob",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Building any analytical workload - ADF , DBX or Synapse\n\n2. Need to store - structured , semi or unstructured files\n\n3. Multiple Compute engines - ADF ,  DBX etc. - simultanious access\n\n4. Folder level security access\n\n5. Atomic Writes \n\n6 Data Volume > 1gb per day for analytics \n                      Don't use - SQL DB, Blob",
      "autoResize": true,
      "lineHeight": 1.25
    },
