      "version": 98,
      "versionNonce": 546176973,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774624275430,
      "link": null,
      "locked": false,
      "text": "Azure Data Lake Storage Gen2 is a cloud-native, massively scalable, enterprise-ready data lake solution \nbuilt on Azure Blob Storage. It combines the capabilities of Azure Blob Storage with a Hadoop-compatible \nfilesystem — specifically the Hierarchical Namespace — enabling directory-based operations, \natomic rename and delete, and fine-grained POSIX-compliant access control. \nADLS Gen2 sits within the Azure Storage account family as a feature flag  — \nenabling HNS on a standard Azure Storage account converts it into a Gen2 data lake.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Azure Data Lake Storage Gen2 is a cloud-native, massively scalable, enterprise-ready data lake solution \nbuilt on Azure Blob Storage. It combines the capabilities of Azure Blob Storage with a Hadoop-compatible \nfilesystem — specifically the Hierarchical Namespace — enabling directory-based operations, \natomic rename and delete, and fine-grained POSIX-compliant access control. \nADLS Gen2 sits within the Azure Storage account family as a feature flag  — \nenabling HNS on a standard Azure Storage account converts it into a Gen2 data lake.",
      "autoResize": false,
      "lineHeight": 1.25
    },
